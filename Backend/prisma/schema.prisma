generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BulkPaymentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CardType {
  CREDIT_CARD
  DEBIT_CARD
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  WEEKDAYS
  WEEKENDS
  CUSTOM_DAYS
}

enum SplitStatus {
  PENDING
  PAYMENT_REQUESTED
  CONFIRMED
  REJECTED
  WAIVED
}

enum PaymentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DelegationStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum RepaymentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TabSplitType {
  MINE_ONLY
  THEIRS_ONLY
  SPLIT
}

enum TabStatus {
  PENDING
  ACTIVE
  DECLINED
  CLOSED
}

enum TabGroupStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum IncomeCategory {
  SALARY
  FREELANCE
  RENTAL
  BUSINESS
  INVESTMENT
  GIFT
  REFUND
  OTHER
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AccountType {
  SAVINGS
  CURRENT
  CREDIT_CARD
  CASH
  WALLET
  METRO_CARD
  OTHER
}

model User {
  id            String        @id @default(cuid())
  firebaseUid   String        @unique
  email         String        @unique
  name          String?
  phone         String?
  photoUrl      String?
  photoPublicId String?
  fcmToken      String?
  upiId         String?

  categories         Category[]
  paymentTypes       PaymentType[]
  people             Person[]           @relation("PersonOwner")
  linkedAs           Person[]           @relation("LinkedUser")
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  budgets              Budget[]
  bulkPaymentsSent     BulkPayment[] @relation("BulkFrom")
  bulkPaymentsReceived BulkPayment[] @relation("BulkTo")
  groupsCreated        Group[]       @relation("GroupCreator")
  groupMemberships     GroupMember[] @relation("GroupMemberUser")
  notifications        Notification[]
  savingsGoal          SavingsGoal?
  loans                Loan[]
  exchangeRates        ExchangeRate[]
  delegationsRequested CardDelegation[] @relation("DelegationRequester")
  delegationsOwned     CardDelegation[] @relation("DelegationOwner")
  repaymentsMade       CardRepayment[]  @relation("RepaymentPayer")
  webauthnCredentials  WebAuthnCredential[]
  tabsCreated          SharedTab[]      @relation("TabCreator")
  tabsMember           SharedTab[]      @relation("TabMember")
  tabGroupsCreated     TabGroup[]       @relation("TabGroupCreator")
  tabGroupsMember      TabGroup[]       @relation("TabGroupMember")
  tabEntries           TabEntry[]       @relation("TabEntryPayer")
  tabSettlements       TabSettlement[]  @relation("TabSettlementPayer")
  tabMemberships       TabMember[]      @relation("TabMemberUser")
  settlementsReceived  TabSettlement[]  @relation("SettlementReceiver")
  contactRequestsSent  ContactRequest[] @relation("ContactRequestSender")
  contactRequestsRecv  ContactRequest[] @relation("ContactRequestRecipient")
  incomes              Income[]
  accounts             Account[]
  creditCardPayments   CreditCardPayment[]
  accountTransfers     AccountTransfer[]
  subscriptions        Subscription[]
  expenseTemplates     ExpenseTemplate[]
  financialGoals       FinancialGoal[]
  assets               Asset[]
  businessPartnerships BusinessPartner[] @relation("BusinessPartners")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([firebaseUid])
}

// ─── BUSINESS MODULE ──────────────────────────────────────────────────────────

enum BusinessRole {
  OWNER
  PARTNER
}

enum PartnerStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum ItemCategory {
  FILAMENT
  PACKAGING
  ELECTRONICS
  HARDWARE
  OTHER
}

enum ItemUnit {
  GRAM
  KG
  PIECE
  METER
  ROLL
}

enum InventoryTxType {
  PURCHASE
  JOB_USE
  ADJUSTMENT
  WASTAGE
  TRANSFER_OUT
  TRANSFER_IN
}

enum JobStatus {
  QUOTED
  IN_PROGRESS
  PRINTED
  DELIVERED
  CANCELLED
}

enum JobItemType {
  FILAMENT
  ADDON
  PACKAGING
  OTHER
}

model Business {
  id        String   @id @default(cuid())
  name      String
  tagline   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners        BusinessPartner[]
  locations       BusinessLocation[]
  settings        BusinessSettings?
  printerProfiles PrinterProfile[]
  items           InventoryItem[]
  jobs            Job[]
  customers       Customer[]
  expenses        BusinessExpense[]
}

model PrinterProfile {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  printerCostRs      Decimal
  printerLifeHr      Decimal
  printerPowerW      Decimal
  electricityRateKwh Decimal
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessPartner {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("BusinessPartners", fields: [userId], references: [id], onDelete: Cascade)
  role           BusinessRole  @default(PARTNER)
  status         PartnerStatus @default(PENDING)
  equityPct      Decimal       @default(50) @db.Decimal(5, 2)
  profitSharePct Decimal       @default(50) @db.Decimal(5, 2)
  createdAt      DateTime      @default(now())

  withdrawals PartnerWithdrawal[]

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  stocks        InventoryStock[]
  transactions  InventoryTransaction[]
  transfersFrom InventoryTransfer[]    @relation("XferFrom")
  transfersTo   InventoryTransfer[]    @relation("XferTo")
  jobs          Job[]
  expenses      BusinessExpense[]

  @@index([businessId])
}

model BusinessSettings {
  id                     String   @id @default(cuid())
  businessId             String   @unique
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  printerCostRs          Decimal  @default(80000) @db.Decimal(10, 2)
  printerLifeHr          Decimal  @default(6000)  @db.Decimal(8, 2)
  printerPowerW          Decimal  @default(160)   @db.Decimal(6, 2)
  electricityRateKwh     Decimal  @default(10)    @db.Decimal(6, 2)
  defaultLabourRateHr    Decimal  @default(150)   @db.Decimal(8, 2)
  labourOnByDefault      Boolean  @default(true)
  defaultFailureRatePct  Decimal  @default(10)    @db.Decimal(5, 2)
  defaultTargetMarginPct Decimal  @default(50)    @db.Decimal(5, 2)
  defaultPaymentFeePct   Decimal  @default(0)     @db.Decimal(5, 2)
  updatedAt              DateTime @updatedAt
}

model InventoryItem {
  id                String       @id @default(cuid())
  businessId        String
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  sku               String?
  category          ItemCategory
  unit              ItemUnit
  costPrice         Decimal      @db.Decimal(10, 4)
  lowStockThreshold Decimal?     @db.Decimal(10, 3)
  isActive          Boolean      @default(true)
  brand             String?
  filamentType      String?
  colorName         String?
  colorHex          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stocks        InventoryStock[]
  transactions  InventoryTransaction[]
  transfers     InventoryTransfer[]
  jobItems      JobItem[]

  @@index([businessId])
}

model InventoryStock {
  id         String           @id @default(cuid())
  itemId     String
  item       InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal          @default(0) @db.Decimal(12, 3)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model InventoryTransaction {
  id         String            @id @default(cuid())
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   BusinessLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type       InventoryTxType
  quantity   Decimal           @db.Decimal(12, 3)
  unitCost   Decimal?          @db.Decimal(10, 4)
  totalCost  Decimal?          @db.Decimal(12, 2)
  jobId      String?
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  transferId String?
  transfer   InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  note       String?
  date       DateTime          @default(now())
  createdAt  DateTime          @default(now())

  @@index([itemId])
  @@index([locationId])
  @@index([jobId])
}

model InventoryTransfer {
  id             String           @id @default(cuid())
  itemId         String
  item           InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocationId String
  fromLocation   BusinessLocation @relation("XferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     BusinessLocation @relation("XferTo", fields: [toLocationId], references: [id])
  quantity       Decimal          @db.Decimal(12, 3)
  note           String?
  date           DateTime         @default(now())
  createdAt      DateTime         @default(now())

  transactions InventoryTransaction[]

  @@index([itemId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs Job[]

  @@index([businessId])
}

model Job {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId  String
  location    BusinessLocation @relation(fields: [locationId], references: [id])
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  title           String
  description     String?
  status          JobStatus @default(QUOTED)

  filamentItemId     String?
  gramsUsed          Decimal? @db.Decimal(8, 3)
  filamentCostPerKg  Decimal? @db.Decimal(10, 2)
  printTimeHr        Decimal  @default(0) @db.Decimal(6, 2)
  printerCostRs      Decimal  @default(80000) @db.Decimal(10, 2)
  printerLifeHr      Decimal  @default(6000)  @db.Decimal(8, 2)
  printerPowerW      Decimal  @default(160)   @db.Decimal(6, 2)
  electricityRateKwh Decimal  @default(10)    @db.Decimal(6, 2)
  labourOn           Boolean  @default(true)
  labourRateHr       Decimal  @default(150)   @db.Decimal(8, 2)
  labourHandsOnMin   Decimal  @default(0)     @db.Decimal(6, 2)
  paymentFeePct      Decimal  @default(0)     @db.Decimal(5, 2)
  failureRatePct     Decimal  @default(10)    @db.Decimal(5, 2)
  targetMarginPct    Decimal  @default(50)    @db.Decimal(5, 2)
  deliveryCost       Decimal  @default(0)     @db.Decimal(10, 2)

  materialCost       Decimal  @default(0) @db.Decimal(10, 2)
  electricityCost    Decimal  @default(0) @db.Decimal(10, 2)
  depreciationCost   Decimal  @default(0) @db.Decimal(10, 2)
  labourCost         Decimal  @default(0) @db.Decimal(10, 2)
  packagingCost      Decimal  @default(0) @db.Decimal(10, 2)
  addOnsCost         Decimal  @default(0) @db.Decimal(10, 2)
  failureMarkup      Decimal  @default(0) @db.Decimal(10, 2)
  trueCost           Decimal  @default(0) @db.Decimal(10, 2)
  suggestedPrice     Decimal  @default(0) @db.Decimal(10, 2)
  actualPrice        Decimal? @db.Decimal(10, 2)
  profit             Decimal? @db.Decimal(10, 2)
  marginPct          Decimal? @db.Decimal(5, 2)

  orderDate    DateTime  @default(now())
  creditAccountId String?
  creditAccount   Account?  @relation("JobCreditAccount", fields: [creditAccountId], references: [id], onDelete: SetNull)
  creditRecorded  Boolean   @default(false)

  deliveryDate DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items                 JobItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([businessId])
  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([creditAccountId])
}

model JobItem {
  id        String         @id @default(cuid())
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  itemId    String?
  item      InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name      String
  quantity  Decimal        @db.Decimal(10, 3)
  unitCost  Decimal        @db.Decimal(10, 4)
  totalCost Decimal        @db.Decimal(10, 2)
  type      JobItemType

  @@index([jobId])
}

model BusinessExpense {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category   String
  amount     Decimal           @db.Decimal(10, 2)
  date       DateTime
  vendor     String?
  note       String?
  accountId  String?
  account    Account?          @relation("BizExpAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([accountId])
}

model PartnerWithdrawal {
  id        String          @id @default(cuid())
  partnerId String
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime
  note      String?
  createdAt DateTime        @default(now())

  @@index([partnerId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceName   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model SavingsGoal {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome  Decimal  @db.Decimal(10, 2) @default(0)
  monthlySavings Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model FinancialGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  emoji        String?
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @db.Decimal(12, 2) @default(0)
  deadline     DateTime?
  color        String?   @default("emerald")
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isCompleted])
}

enum AssetType {
  CASH
  BANK
  INVESTMENT
  PROPERTY
  VEHICLE
  OTHER
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(SAVINGS)
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  color          String?
  icon           String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  expenses       Expense[]
  incomes        Income[]
  cardPaymentsReceived CreditCardPayment[] @relation("CardPaymentsReceived")
  bankPaymentsSent     CreditCardPayment[] @relation("BankPaymentsSent")
  paymentTypes         PaymentType[]       @relation("PaymentTypeAccount")
  transfersFrom        AccountTransfer[]   @relation("TransferFrom")
  transfersTo          AccountTransfer[]   @relation("TransferTo")
  bizExpenses          BusinessExpense[]   @relation("BizExpAccount")
  jobCredits           Job[]               @relation("JobCreditAccount")

  @@index([userId])
}

model AccountTransfer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal  @db.Decimal(14, 2)
  transferDate  DateTime
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model CreditCardPayment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCardAccountId String
  creditCardAccount   Account  @relation("CardPaymentsReceived", fields: [creditCardAccountId], references: [id])
  fromAccountId       String?
  fromAccount         Account? @relation("BankPaymentsSent", fields: [fromAccountId], references: [id], onDelete: SetNull)
  amount              Decimal  @db.Decimal(14, 2)
  paymentDate         DateTime
  note                String?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([creditCardAccountId])
  @@index([fromAccountId])
}

model Asset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String?
  type      AssetType @default(OTHER)
  value     Decimal   @db.Decimal(14, 2)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]
  templates         ExpenseTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model PaymentType {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isDefault Boolean   @default(false)

  cardType           CardType?
  billingCycleDay    Int?
  paymentDueDay      Int?
  reminderDaysBefore Int?
  reminderEnabled    Boolean   @default(false)

  cardLastFour    String?
  cardHolderName  String?
  cardExpiry      String?

  linkedAccountId   String?
  linkedAccount     Account?  @relation("PaymentTypeAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  delegation        CardDelegation?          @relation("RequesterCard")
  ownerDelegations  CardDelegation[]         @relation("OwnerCard")
  templates         ExpenseTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model CardDelegation {
  id            String           @id @default(cuid())
  paymentTypeId String           @unique
  paymentType   PaymentType      @relation("RequesterCard", fields: [paymentTypeId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User             @relation("DelegationRequester", fields: [requestedById], references: [id])
  ownerId       String
  owner         User             @relation("DelegationOwner", fields: [ownerId], references: [id])
  status        DelegationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  approvedAt    DateTime?

  ownerPaymentTypeId String?
  ownerPaymentType   PaymentType? @relation("OwnerCard", fields: [ownerPaymentTypeId], references: [id], onDelete: SetNull)

  expenses   Expense[]
  repayments CardRepayment[]

  @@index([requestedById])
  @@index([ownerId])
}

model CardRepayment {
  id           String          @id @default(cuid())
  delegationId String
  delegation   CardDelegation  @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  payerId      String
  payer        User            @relation("RepaymentPayer", fields: [payerId], references: [id])
  amount       Decimal         @db.Decimal(10, 2)
  note         String?
  expenseIds   String[]
  status       RepaymentStatus @default(PENDING_APPROVAL)
  createdAt    DateTime        @default(now())
  approvedAt   DateTime?

  @@index([delegationId])
  @@index([payerId])
}

model Person {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("PersonOwner", fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  linkedUserId String?
  linkedUser   User?           @relation("LinkedUser", fields: [linkedUserId], references: [id])

  expenses        ExpensePerson[]
  splits          ExpenseSplit[]
  paidForExpenses Expense[]       @relation("PaidFor")

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([linkedUserId])
}

model Expense {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("INR")
  rateAtTime    Decimal?        @db.Decimal(10, 4)
  title         String?
  note          String?
  expenseDate   DateTime

  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  paymentTypeId String
  paymentType   PaymentType     @relation(fields: [paymentTypeId], references: [id])

  paidForPersonId    String?
  paidForPerson      Person?          @relation("PaidFor", fields: [paidForPersonId], references: [id], onDelete: SetNull)

  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  receiptUrl      String?
  tags            String[]  @default([])
  isReimbursement Boolean   @default(false)

  delegationId    String?
  delegation      CardDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  isDelegatedCard Boolean         @default(false)
  willRepay       Boolean         @default(false)
  isRepaid        Boolean         @default(false)

  tabEntryId      String?
  tabEntry        TabEntry?      @relation(fields: [tabEntryId], references: [id], onDelete: Cascade)
  tabSettlementId String?        @unique
  tabSettlement   TabSettlement? @relation(fields: [tabSettlementId], references: [id], onDelete: Cascade)

  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  people        ExpensePerson[]
  splits        ExpenseSplit[]
  comments      ExpenseComment[]
  items         ExpenseItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tabEntryId, userId])
  @@index([userId, expenseDate(sort: Desc)])
  @@index([userId, paidForPersonId])
  @@index([userId, categoryId])
  @@index([userId, paymentTypeId])
  @@index([groupId])
}

model ExpenseItem {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal @db.Decimal(14, 2)
  qty       Float?
  unit      String?
  order     Int     @default(0)

  @@index([expenseId])
}

model ExpensePerson {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([expenseId, personId])
}

model ExpenseSplit {
  id        String       @id @default(cuid())
  expenseId String
  expense   Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  personId  String
  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(10, 2)
  status    SplitStatus  @default(PENDING)

  paymentRequests   PaymentRequest[]
  bulkPaymentSplits BulkPaymentSplit[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([expenseId, personId])
  @@index([expenseId])
  @@index([personId])
  @@index([personId, status])
  @@index([expenseId, status])
}

model PaymentRequest {
  id        String               @id @default(cuid())
  splitId   String
  split     ExpenseSplit         @relation(fields: [splitId], references: [id], onDelete: Cascade)
  note      String?
  status    PaymentRequestStatus @default(PENDING)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([splitId])
}

model RecurringExpense {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("INR")
  title         String?
  note          String?
  categoryId    String?
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentTypeId String
  paymentType   PaymentType         @relation(fields: [paymentTypeId], references: [id])
  frequency     RecurrenceFrequency
  customDays    Int[]               @default([])
  nextDueDate   DateTime
  endDate       DateTime?
  isActive      Boolean             @default(true)

  instances     Expense[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, isActive, nextDueDate])
}

model BulkPayment {
  id          String            @id @default(cuid())
  fromUserId  String
  fromUser    User              @relation("BulkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User              @relation("BulkTo", fields: [toUserId], references: [id], onDelete: Cascade)
  totalAmount Decimal           @db.Decimal(10, 2)
  note        String?
  status      BulkPaymentStatus @default(PENDING)
  splits      BulkPaymentSplit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model BulkPaymentSplit {
  bulkPaymentId String
  bulkPayment   BulkPayment  @relation(fields: [bulkPaymentId], references: [id], onDelete: Cascade)
  splitId       String
  split         ExpenseSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@id([bulkPaymentId, splitId])
  @@index([splitId])
}

enum GroupType {
  TRIP
  HOME
  WORK
  COUPLE
  OTHER
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupSplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

model Group {
  id              String            @id @default(cuid())
  name            String
  icon            String            @default("👥")
  type            GroupType         @default(OTHER)
  createdByUserId String
  createdBy       User              @relation("GroupCreator", fields: [createdByUserId], references: [id])
  members         GroupMember[]
  groupExpenses   GroupExpense[]
  settlements     GroupSettlement[]
  linkedExpenses  Expense[]
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdByUserId])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation("GroupMemberUser", fields: [userId], references: [id])
  name      String
  email     String?
  role      GroupRole @default(MEMBER)

  expensesPaid    GroupExpense[]    @relation("GroupExpensePayer")
  expensesAdded   GroupExpense[]    @relation("GroupExpenseAdder")
  shares          GroupExpenseShare[]
  settlementsFrom GroupSettlement[] @relation("SettleFrom")
  settlementsTo   GroupSettlement[] @relation("SettleTo")

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupExpense {
  id              String           @id @default(cuid())
  groupId         String
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedByMemberId String
  addedBy         GroupMember      @relation("GroupExpenseAdder", fields: [addedByMemberId], references: [id])
  paidByMemberId  String
  paidBy          GroupMember      @relation("GroupExpensePayer", fields: [paidByMemberId], references: [id])
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("INR")
  rateAtTime      Decimal?         @db.Decimal(10, 4)
  title           String
  note            String?
  expenseDate     DateTime
  splitType       GroupSplitType   @default(EQUAL)
  shares          GroupExpenseShare[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([groupId])
  @@index([paidByMemberId])
}

model GroupExpenseShare {
  id             String       @id @default(cuid())
  groupExpenseId String
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  memberId       String
  member         GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)

  @@unique([groupExpenseId, memberId])
  @@index([memberId])
}

model GroupSettlement {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("SettleFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("SettleTo", fields: [toMemberId], references: [id])
  amount       Decimal     @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime    @default(now())

  @@index([groupId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency String
  toCurrency   String   @default("INR")
  rate         Decimal  @db.Decimal(10, 4)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, fromCurrency, toCurrency])
  @@index([userId])
}

model ExpenseComment {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  text      String
  createdAt DateTime @default(now())

  @@index([expenseId, createdAt(sort: Desc)])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model Loan {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  principal    Decimal       @db.Decimal(12, 2)
  interestRate Decimal       @db.Decimal(5, 2)
  tenureMonths Int
  startDate    DateTime
  emiAmount    Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  payments     LoanPayment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model LoanPayment {
  id     String   @id @default(cuid())
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month  Int
  amount Decimal  @db.Decimal(10, 2)
  paidAt DateTime @default(now())
  note   String?

  @@unique([loanId, month])
  @@index([loanId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  lastAlertPct Int    @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model TabGroup {
  id        String         @id @default(cuid())
  name      String
  status    TabGroupStatus @default(PENDING)
  creatorId String
  creator   User           @relation("TabGroupCreator", fields: [creatorId], references: [id])
  memberId  String
  member    User           @relation("TabGroupMember", fields: [memberId], references: [id])
  tabs      SharedTab[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([creatorId])
  @@index([memberId])
}

model SharedTab {
  id        String          @id @default(cuid())
  name      String
  status    TabStatus       @default(PENDING)
  creatorId String
  creator   User            @relation("TabCreator", fields: [creatorId], references: [id])
  memberId  String?
  member    User?           @relation("TabMember", fields: [memberId], references: [id])
  members   TabMember[]
  groupId   String?
  group     TabGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month     Int?
  year      Int?
  entries   TabEntry[]
  settlements TabSettlement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([creatorId])
  @@index([memberId])
  @@index([groupId])
}

model TabEntry {
  id          String       @id @default(cuid())
  tabId       String
  tab         SharedTab    @relation(fields: [tabId], references: [id], onDelete: Cascade)
  paidById    String
  paidBy      User         @relation("TabEntryPayer", fields: [paidById], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  description String
  date        DateTime
  splitType   TabSplitType
  splitRatio  Float        @default(50)
  category    String?
  note        String?
  createdAt   DateTime     @default(now())
  expenses    Expense[]

  @@index([tabId])
  @@index([paidById])
}

model TabSettlement {
  id        String    @id @default(cuid())
  tabId     String
  tab       SharedTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  paidById  String
  paidBy    User      @relation("TabSettlementPayer", fields: [paidById], references: [id])
  toUserId  String?
  toUser    User?     @relation("SettlementReceiver", fields: [toUserId], references: [id])
  amount    Decimal   @db.Decimal(10, 2)
  note      String?
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
  expense   Expense?

  @@index([tabId])
  @@index([paidById])
  @@index([toUserId])
}

model TabMember {
  id        String    @id @default(cuid())
  tabId     String
  tab       SharedTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation("TabMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  isCreator Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([tabId, userId])
  @@index([tabId])
  @@index([userId])
}

model Income {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(10, 2)
  currency   String         @default("INR")
  title      String
  category   IncomeCategory @default(OTHER)
  source     String?
  incomeDate DateTime
  note       String?
  tags       String[]       @default([])
  accountId  String?
  account    Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, incomeDate(sort: Desc)])
  @@index([userId, category])
}

model Subscription {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal      @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  nextDueDate  DateTime
  category     String       @default("Entertainment")
  logo         String?
  isAutoPay    Boolean      @default(false)
  isActive     Boolean      @default(true)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, nextDueDate])
  @@index([userId, isActive])
}

model ContactRequest {
  id             String               @id @default(cuid())
  senderId       String
  sender         User                 @relation("ContactRequestSender", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?                @relation("ContactRequestRecipient", fields: [recipientId], references: [id])
  recipientEmail String
  status         ContactRequestStatus @default(PENDING)
  inviteToken    String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([senderId, recipientEmail])
  @@index([senderId])
  @@index([recipientId])
  @@index([recipientEmail])
}

model ExpenseTemplate {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  emoji         String?
  amount        Decimal?     @db.Decimal(10, 2)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentTypeId String?
  paymentType   PaymentType? @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull)
  note          String?
  usageCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, usageCount(sort: Desc)])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BulkPaymentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SplitStatus {
  PENDING
  PAYMENT_REQUESTED
  CONFIRMED
  REJECTED
  WAIVED
}

enum PaymentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  firebaseUid   String        @unique
  email         String        @unique
  name          String?
  phone         String?
  photoUrl      String?
  photoPublicId String?
  fcmToken      String?

  categories         Category[]
  paymentTypes       PaymentType[]
  people             Person[]           @relation("PersonOwner")
  linkedAs           Person[]           @relation("LinkedUser")
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  budgets              Budget[]
  bulkPaymentsSent     BulkPayment[] @relation("BulkFrom")
  bulkPaymentsReceived BulkPayment[] @relation("BulkTo")
  groupsCreated        Group[]       @relation("GroupCreator")
  groupMemberships     GroupMember[] @relation("GroupMemberUser")
  notifications        Notification[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([firebaseUid])
}

model Category {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model PaymentType {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isDefault Boolean   @default(false)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Person {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("PersonOwner", fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  linkedUserId String?
  linkedUser   User?           @relation("LinkedUser", fields: [linkedUserId], references: [id])

  expenses        ExpensePerson[]
  splits          ExpenseSplit[]
  paidForExpenses Expense[]       @relation("PaidFor")

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([linkedUserId])
}

model Expense {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("INR")
  title         String?
  note          String?
  expenseDate   DateTime

  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  paymentTypeId String
  paymentType   PaymentType     @relation(fields: [paymentTypeId], references: [id])

  paidForPersonId    String?
  paidForPerson      Person?          @relation("PaidFor", fields: [paidForPersonId], references: [id], onDelete: SetNull)

  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  receiptUrl    String?

  people        ExpensePerson[]
  splits        ExpenseSplit[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, expenseDate(sort: Desc)])
  @@index([userId, paidForPersonId])
  @@index([userId, categoryId])
  @@index([userId, paymentTypeId])
  @@index([groupId])
}

model ExpensePerson {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([expenseId, personId])
}

model ExpenseSplit {
  id        String       @id @default(cuid())
  expenseId String
  expense   Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  personId  String
  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(10, 2)
  status    SplitStatus  @default(PENDING)

  paymentRequests   PaymentRequest[]
  bulkPaymentSplits BulkPaymentSplit[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([expenseId, personId])
  @@index([expenseId])
  @@index([personId])
}

model PaymentRequest {
  id        String               @id @default(cuid())
  splitId   String
  split     ExpenseSplit         @relation(fields: [splitId], references: [id], onDelete: Cascade)
  note      String?
  status    PaymentRequestStatus @default(PENDING)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([splitId])
}

model RecurringExpense {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("INR")
  title         String?
  note          String?
  categoryId    String?
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentTypeId String
  paymentType   PaymentType         @relation(fields: [paymentTypeId], references: [id])
  frequency     RecurrenceFrequency
  nextDueDate   DateTime
  endDate       DateTime?
  isActive      Boolean             @default(true)

  instances     Expense[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, isActive, nextDueDate])
}

model BulkPayment {
  id          String            @id @default(cuid())
  fromUserId  String
  fromUser    User              @relation("BulkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User              @relation("BulkTo", fields: [toUserId], references: [id], onDelete: Cascade)
  totalAmount Decimal           @db.Decimal(10, 2)
  note        String?
  status      BulkPaymentStatus @default(PENDING)
  splits      BulkPaymentSplit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model BulkPaymentSplit {
  bulkPaymentId String
  bulkPayment   BulkPayment  @relation(fields: [bulkPaymentId], references: [id], onDelete: Cascade)
  splitId       String
  split         ExpenseSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@id([bulkPaymentId, splitId])
  @@index([splitId])
}

enum GroupType {
  TRIP
  HOME
  WORK
  COUPLE
  OTHER
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupSplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

model Group {
  id              String            @id @default(cuid())
  name            String
  icon            String            @default("👥")
  type            GroupType         @default(OTHER)
  createdByUserId String
  createdBy       User              @relation("GroupCreator", fields: [createdByUserId], references: [id])
  members         GroupMember[]
  groupExpenses   GroupExpense[]
  settlements     GroupSettlement[]
  linkedExpenses  Expense[]
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdByUserId])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation("GroupMemberUser", fields: [userId], references: [id])
  name      String
  email     String?
  role      GroupRole @default(MEMBER)

  expensesPaid    GroupExpense[]    @relation("GroupExpensePayer")
  expensesAdded   GroupExpense[]    @relation("GroupExpenseAdder")
  shares          GroupExpenseShare[]
  settlementsFrom GroupSettlement[] @relation("SettleFrom")
  settlementsTo   GroupSettlement[] @relation("SettleTo")

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupExpense {
  id              String           @id @default(cuid())
  groupId         String
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedByMemberId String
  addedBy         GroupMember      @relation("GroupExpenseAdder", fields: [addedByMemberId], references: [id])
  paidByMemberId  String
  paidBy          GroupMember      @relation("GroupExpensePayer", fields: [paidByMemberId], references: [id])
  amount          Decimal          @db.Decimal(10, 2)
  title           String
  note            String?
  expenseDate     DateTime
  splitType       GroupSplitType   @default(EQUAL)
  shares          GroupExpenseShare[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([groupId])
  @@index([paidByMemberId])
}

model GroupExpenseShare {
  id             String       @id @default(cuid())
  groupExpenseId String
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  memberId       String
  member         GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)

  @@unique([groupExpenseId, memberId])
  @@index([memberId])
}

model GroupSettlement {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("SettleFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("SettleTo", fields: [toMemberId], references: [id])
  amount       Decimal     @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime    @default(now())

  @@index([groupId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}
